{% extends 'base.html.twig' %}

{% block title %}Latest Publications — {{ website_name }}{% endblock %}

{% block body %}
    <div class="search-page publications-page">
        <h1>Latest Publications</h1>
        <p class="text-subtle">Publications from the network (recent indices).</p>

        {% if indices is not empty %}
            <div class="publications-grid article-list">
                {% for index in indices %}
                    {% include 'components/Molecules/PublicationCard.html.twig' with { index: index } only %}
                {% endfor %}
            </div>
        {% else %}
            <p><small>No publication indices in the local cache yet. Run <code>app:prewarm</code> (publication index phase) or wait for the prewarm service.</small></p>
        {% endif %}

        {% if pagination.last_page > 1 %}
            {% set _page = pagination.page %}
            {% set _last = pagination.last_page %}
            {% set _prev_url = _page > 1 ? path('publications', _page > 2 ? { page: _page - 1 } : {}) : null %}
            {% set _next_url = _page < _last ? path('publications', { page: _page + 1 }) : null %}
            {% include 'components/Molecules/Pagination.html.twig' with {
                page: _page,
                last_page: _last,
                prev_url: _prev_url,
                next_url: _next_url,
                aria_label: 'Publications pagination',
            } only %}
        {% endif %}
    </div>
{% endblock %}
