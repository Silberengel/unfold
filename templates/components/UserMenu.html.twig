<div
    class="user-menu{{ inline ? ' user-menu--inline' : '' }}"
    {{ attributes.defaults(stimulus_controller('login', {
        noExtensionMessage: 'login.error_no_extension'|trans,
        cancelledMessage: 'login.error_cancelled'|trans,
        failedMessage: 'login.error_failed'|trans,
        amberPromptMessage: 'login.amber_prompt'|trans,
        amberInvalidUrlMessage: 'login.amber_invalid_url'|trans,
        amberWaitingMessage: 'login.amber_waiting'|trans,
        amberConnectedMessage: 'login.amber_connected'|trans,
        copyUriLabel: 'login.amber_copy_link'|trans,
        copiedMessage: 'login.amber_copied'|trans,
        nip46Relays: nip46_client_relays,
        siteName: website_name,
        siteUrl: app.request.schemeAndHttpHost,
    })) }}
>
    {% if app.user %}
        <div class="notice info">
            <twig:Molecules:UserFromNpub ident="{{ app.user.npub }}" />
            {% if is_granted('ROLE_ADMIN') %}<span class="badge">Admin</span>{% endif %}
        </div>
        {% if is_granted('ROLE_ADMIN') %}
{#        <ul>#}
{#            <li>#}
{#                <a href="{{ path('admin_roles') }}">{{ 'heading.roles'|trans }}</a>#}
{#            </li>#}
{#        </ul>#}
        {% endif %}
        <ul class="user-nav user-menu__account-nav" role="list">
{#            <li>#}
{#                <a href="{{ path('editor-create') }}">Write an article</a>#}
{#            </li>#}
            <li>
                <a href="/logout" data-action="click->login#authLogout click->live#$render">{{ 'heading.logout'|trans }}</a>
            </li>
            <li
                data-controller="footer-magazine-edit"
                data-footer-magazine-edit-publisher-npub-value="{{ publisher_npub }}"
                {% if not (app.user.userIdentifier == publisher_npub) %}hidden{% endif %}
            >
                <a href="{{ path('magazine_edit') }}">Edit magazine</a>
            </li>
            <li>
                <a href="{{ path('search') }}">{{ 'heading.search'|trans }}</a>
            </li>
        </ul>
    {% else %}
        <div class="notice info">
            <p>Log in to access search.</p>
        </div>
        <p class="notice error user-menu__login-error" data-login-target="error" role="alert" hidden></p>
        <div class="user-menu__login-actions">
            <button
                type="button"
                class="btn btn-primary"
                data-login-target="submitButton"
                data-action="click->login#loginAct"
            >{{ 'login.extension'|trans }}</button>
            <button
                type="button"
                class="btn btn-primary"
                data-login-target="amberToggleButton"
                aria-expanded="false"
                data-action="click->login#toggleAmberPanel"
            >{{ 'login.amber_toggle'|trans }}</button>
        </div>
        <div class="user-menu__amber-panel" data-login-target="amberPanel" hidden>
            <p class="user-menu__section-label">{{ 'login.amber_scan_heading'|trans }}</p>
            <div class="user-menu__amber-qr-section">
                <p class="user-menu__amber-help">{{ 'login.amber_qr_help'|trans }}</p>
                <canvas class="user-menu__amber-qr" data-login-target="qrCanvas" width="220" height="220"></canvas>
                <label class="user-menu__amber-label" for="user-menu-connect-uri">{{ 'login.amber_link_label'|trans }}</label>
                <div class="user-menu__amber-uri-row">
                    <input
                        id="user-menu-connect-uri"
                        type="text"
                        class="user-menu__amber-uri-input"
                        data-login-target="connectUriInput"
                        readonly
                        spellcheck="false"
                        autocomplete="off"
                        aria-label="{{ 'login.amber_link_label'|trans }}"
                    >
                    <button
                        type="button"
                        class="user-menu__amber-copy"
                        data-login-target="copyUriButton"
                        data-action="click->login#copyConnectUriAct"
                    >{{ 'login.amber_copy_link'|trans }}</button>
                </div>
                <p class="user-menu__amber-status" data-login-target="amberStatus" role="status" hidden></p>
            </div>
            <p class="user-menu__section-label user-menu__section-label--spaced">{{ 'login.amber_paste_heading'|trans }}</p>
            <p class="user-menu__amber-help">{{ 'login.amber_help'|trans }}</p>
            <label class="user-menu__amber-label" for="user-menu-signer-url">{{ 'login.amber_url_label'|trans }}</label>
            <input
                id="user-menu-signer-url"
                type="text"
                class="user-menu__amber-input"
                data-login-target="bunkerInput"
                placeholder="{{ 'login.amber_url_placeholder'|trans }}"
                autocomplete="off"
                spellcheck="false"
                inputmode="url"
            >
            <button
                type="button"
                class="btn btn-primary"
                data-login-target="amberSubmitButton"
                data-action="click->login#loginWithAmberAct"
            >{{ 'login.amber_submit'|trans }}</button>
        </div>
    {% endif %}
    <div>
        <div class="spinner" data-loading>
            <div class="lds-dual-ring"></div>
        </div>
    </div>
</div>
