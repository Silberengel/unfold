{% set d = index.slug %}
{% set pk = index.pubkey %}
{% set npub = npub_from_hex(pk) %}
{% set href = path('publication', { npub: npub, slug: d }) %}
{% set card_title = '' %}
{% for tag in index.tags %}
    {% if tag[0] == 'title' and card_title == '' %}
        {% set card_title = tag[1]|default('') %}
    {% endif %}
{% endfor %}
{% set card_summary = '' %}
{% set card_image = '' %}
{% for tag in index.tags %}
    {% if tag[0] == 'summary' and card_summary == '' %}
        {% set card_summary = tag[1]|default('') %}
    {% elseif tag[0] == 'image' and card_image == '' %}
        {% set card_image = tag[1]|default('') %}
    {% endif %}
{% endfor %}

<div class="card publication-card">
    <div class="metadata">
        <p>by <twig:Molecules:UserFromNpub ident="{{ pk }}" :faviconFallback="true" /></p>
        <small>{{ index.createdAt|date('F j Y') }}</small>
    </div>
    <a href="{{ href }}">
        {% set _no_cover = card_image|trim == '' %}
        <div class="card-header{{ _no_cover ? ' card-header--no-cover' : '' }}">
            <img
                src="{{ publication_card_cover(card_image, pk) }}"
                alt="{{ ('Illustration for ' ~ (card_title != '' ? card_title : d|replace({'-': ' '})|title))|e('html_attr') }}"
                width="800"
                height="450"
                loading="lazy"
                decoding="async"
                onerror="this.onerror=null;this.src='{{ asset('icons/favicon-96x96.png')|e('js') }}';"
            >
        </div>
        <div class="card-body">
            <h2 class="card-title">{{ card_title != '' ? card_title : d }}</h2>
            {% if card_summary|trim != '' %}
                <p class="lede">{{ card_summary }}</p>
            {% endif %}
        </div>
    </a>
</div>
