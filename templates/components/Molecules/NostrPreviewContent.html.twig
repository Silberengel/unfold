{% if preview.type == 'naddr' %}
    {% set naddr_title = null %}
    {% set naddr_summary = null %}
    {% if preview.tags is defined %}
        {% for tag in preview.tags %}
            {% if tag[0] == 'title' and naddr_title is null and tag[1] is defined and tag[1]|default('')|trim != '' %}
                {% set naddr_title = tag[1] %}
            {% elseif tag[0] == 'summary' and naddr_summary is null and tag[1] is defined and tag[1]|default('')|trim != '' %}
                {% set naddr_summary = tag[1] %}
            {% endif %}
        {% endfor %}
    {% endif %}
    {% set _na_share = nostr_event_share(preview) %}
    {% set _naddr_href = preview.identifier is defined ? naddr_internal_url(preview.identifier) : null %}
    {% if _naddr_href %}
    <a href="{{ _naddr_href }}" class="nostr-preview-card-link">
    {% endif %}
    <div class="card nostr-address-preview{% if _na_share %} nostr-address-preview--with-menu{% endif %}">
        {% if _na_share %}
            <div class="nostr-preview-card__menu">
                {% include 'components/Molecules/NostrShareMenu.html.twig' with { share: _na_share, event_menu: true } only %}
            </div>
        {% endif %}
        <div class="card-body nostr-address-preview__body">
            {% if naddr_title %}
                <h5 class="card-title">{{ naddr_title }}</h5>
            {% endif %}
            <p class="card-text">
                {% if naddr_summary %}
                    {{ naddr_summary }}
                {% elseif preview.content is defined and preview.content|trim != '' %}
                    {{ preview.content|length > 220 ? preview.content|slice(0, 220) ~ '…' : preview.content }}
                {% else %}
                    <span class="text-subtle">—</span>
                {% endif %}
            </p>
            {% if preview.kind is defined and preview.kind == 30040 %}
                <span class="ui-badge ui-badge--brand">Publication</span>
            {% endif %}
        </div>
    </div>
    {% if _naddr_href %}
    </a>
    {% endif %}
{% elseif preview.type == 'nevent' %}
    {% if preview.kind == 9802 %}
        <div class="card nostr-highlight-preview">
            <div class="card-header nostr-card-header">
                <div>
                    <twig:Molecules:UserFromNpub ident="{{ preview.pubkey }}" />
                </div>
                <div class="nostr-card-header__actions">
                    <span class="ui-badge ui-badge--brand">Highlight</span>
                    {% set _hi_share = nostr_event_share(preview) %}
                    {% if _hi_share %}{% include 'components/Molecules/NostrShareMenu.html.twig' with { share: _hi_share, event_menu: true } only %}{% endif %}
                </div>
            </div>
            <div class="card-body">
                {% if preview.content_html is defined and preview.content_html|default('')|trim != '' %}
                    <div class="nostr-preview-card__body-html">{{ preview.content_html|raw }}</div>
                {% else %}
                <p>{{ preview.content }}</p>
                {% endif %}
                {% if preview.tags is defined and preview.tags|length > 0 %}
                    <blockquote class="card-text">
                        {% for tag in preview.tags %}
                            {% if tag[0] == 'textquoteselector' %}
                                {% for i in 1..tag|length-1 %}
                                    <span class="quoted-text">{{ tag[i] }}</span>
                                    {% if not loop.last %}
                                        <br>
                                    {% endif %}
                                {% endfor %}
                            {% endif %}
                        {% endfor %}
                    </blockquote>
                {% endif %}
            </div>
        </div>
    {% else %}
        {% set is_longform = preview.kind == 30023 or preview.kind == 30024 or preview.kind == 30817 %}
        {% set is_publication = preview.kind == 30040 %}
        {% set is_asciidoc_section = preview.kind == 30041 or preview.kind == 30818 %}
        {% set article_title = null %}
        {% set article_summary = null %}
        {% if preview.tags is defined %}
            {% for tag in preview.tags %}
                {% if tag[0] == 'title' %}
                    {% set article_title = tag[1] %}
                {% elseif tag[0] == 'summary' %}
                    {% set article_summary = tag[1] %}
                {% endif %}
            {% endfor %}
        {% endif %}
        <div class="card nostr-event-preview">
            <div class="card-header nostr-card-header">
                <div>
                    <twig:Molecules:UserFromNpub ident="{{ preview.pubkey }}" />
                </div>
                <div class="nostr-card-header__actions">
                    {% if is_publication %}
                        <span class="ui-badge ui-badge--brand">Publication</span>
                    {% elseif is_longform %}
                        <span class="ui-badge ui-badge--secondary">Article</span>
                    {% elseif is_asciidoc_section %}
                        <span class="ui-badge ui-badge--secondary">Section</span>
                    {% else %}
                        <span class="ui-badge ui-badge--primary">Note</span>
                    {% endif %}
                    {% set _evp_share = nostr_event_share(preview) %}
                    {% if _evp_share %}{% include 'components/Molecules/NostrShareMenu.html.twig' with { share: _evp_share, event_menu: true } only %}{% endif %}
                </div>
            </div>
            <div class="card-body">
                {% if is_longform %}
                    <h5 class="card-title">{{ article_title ?: 'Article' }}</h5>
                    {% if article_summary %}
                        <p class="card-text">{{ article_summary }}</p>
                    {% elseif preview.content_html is defined and preview.content_html|default('')|trim != '' %}
                        <div class="card-text nostr-preview-card__body-html">{{ preview.content_html|raw }}</div>
                    {% elseif preview.content is defined %}
                        <p class="card-text">{{ preview.content|length > 150 ? preview.content|slice(0, 150) ~ '...' : preview.content }}</p>
                    {% endif %}
                {% elseif preview.content_html is defined and preview.content_html|default('')|trim != '' %}
                    <div class="card-text nostr-preview-card__body-html">{{ preview.content_html|raw }}</div>
                {% else %}
                    <p class="card-text">{{ preview.content|length > 280 ? preview.content|slice(0, 280) ~ '...' : preview.content }}</p>
                {% endif %}
            </div>
            <div class="card-footer nostr-preview-card__meta text-subtle">
                <small>{{ preview.created_at is defined ? preview.created_at|date('F j Y') : '' }}</small>
            </div>
        </div>
    {% endif %}
{% elseif preview.type == 'nprofile' %}
    {{ user_badge(preview.pubkey|default(preview.npub)) }}
{% endif %}
